{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appss",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2722e17c-2fda-4579-963d-cc9f40aa6307","database_name": "web-appss" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9fe0e06b49614b3292ff68e57a3d98c8" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
